{% set theNode = { id: 'home' } %}

{% macro nav(node, theNode, navTree, depth) %}
    {% import _self as cms_nav %}
    {% set children = node.children|default([]) %}
    {% set selected = theNode and node.id|default('') == theNode.id|default('') %}
    {% set open = selected or node.expanded|default(false) or not node.url|default('') %}
    <li class="nav-item{{ selected ? ' active' : '' }}">
        {% if node.url|default('') %}
            <div class="nav-item-row">
                <a class="nav-link px-1 py-1{{ selected ? ' active' : '' }}" href="{{ node.url }}"{% if selected %} aria-current="page"{% endif %}>
                    {{ node.title }}
                </a>
                {% if children|length %}
                    <button type="button" class="nav-caret" data-bs-toggle="collapse" data-bs-target="#{{ node.id }}" aria-expanded="{{ open ? 'true' : 'false' }}" aria-controls="{{ node.id }}">
                        <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </div>
        {% else %}
            <div class="cms-nav-heading">{{ node.title }}</div>
        {% endif %}

        {% if children|length %}
            <div class="collapse{{ open ? ' show' : '' }}" id="{{ node.id }}">
                <ul class="nav flex-column{{ node.url|default('') ? ' nav-sub' : '' }}">
                    {% for child in children %}
                        {{ cms_nav.nav(child, theNode, navTree, depth + 1) }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </li>
{% endmacro %}

{% import _self as cms_nav %}

{#-
  cms_nav_tree(sections, tree_id)
  sections[]: { heading, items[] }
  items[]:    { label, href, current, expanded, id, children[] }
-#}
{% macro cms_nav_items(items, tree_id, nested) %}
    {% import _self as nav %}
    <ul class="nav flex-column{{ nested ? ' nav-sub' : '' }}">
        {% for item in items %}
            {% set children = item.children|default([]) %}
            {% set is_current = item.current|default(false) %}
            {% set is_expanded = item.expanded|default(false) %}
            {% set href = item.href|default('#') %}
            <li class="nav-item">
                {% if children|length %}
                    {% set collapse_id = item.id|default('nav-' ~ item.label|lower|replace({' & ': '-', '&': '', ' ': '-'})) %}
                    <a class="nav-link nav-toggle px-1 py-1{{ is_current ? ' active' : '' }}" href="#{{ collapse_id }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ is_expanded ? 'true' : 'false' }}" aria-controls="{{ collapse_id }}"{% if is_current %} aria-current="page"{% endif %}>
                        <span>{{ item.label }}</span>
                        <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                    </a>
                    <div class="collapse{{ is_expanded ? ' show' : '' }}" id="{{ collapse_id }}" data-bs-parent="#{{ tree_id }}">
                        {{ nav.cms_nav_items(children, tree_id, true) }}
                    </div>
                {% else %}
                    <a class="nav-link px-1 py-1{{ is_current ? ' active' : '' }}" href="{{ href }}"{% if is_current %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% macro cms_nav_tree(sections, tree_id) %}
    {% import _self as nav %}
    {% for section in sections %}
        <div{% if not loop.last %} class="mb-3"{% endif %}>
            {% if section.heading|default('') %}
                <div class="cms-nav-heading">{{ section.heading }}</div>
            {% endif %}
            {{ nav.cms_nav_items(section.items|default([]), tree_id, false) }}
        </div>
    {% endfor %}
{% endmacro %}


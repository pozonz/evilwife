        }
        .cms-nav-tree .nav-item.active > .nav-item-row > .nav-link,
        .cms-nav-tree .nav-link.active,
        .cms-nav-tree .nav-link[aria-current="page"] {
            color: var(--bs-body-color);
            font-weight: 600;
            background-color: var(--bs-secondary-bg);
        }
        .cms-nav-tree .nav-chevron {
            font-size: 0.65rem;
            opacity: 0.7;
            transition: transform 0.2s ease;
        }
        .cms-nav-tree .nav-caret[aria-expanded="true"] .nav-chevron {
            transform: rotate(180deg);
        }
        .cms-nav-tree .nav-sub {
            padding-left: 0.7rem;
            border-left: 1px solid var(--bs-border-color);
            margin: 0.1rem 0 0.2rem 0.45rem;
        }
        .cms-main {

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>CMS Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/css/adminlte.min.css" />
</head>
<body class="bg-body-tertiary">
    <div class="container py-5">
        <h1>Welcome, {{ username }}</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <p class="mt-3">
            <a href="{{ path('manage_2fa_settings') }}" class="btn btn-outline-primary">Two-factor authentication</a>
            <a href="{{ path('manage_logout') }}" class="btn btn-outline-secondary">Sign out</a>
        </p>
    </div>
</body>
</html>
